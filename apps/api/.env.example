# ===== 基础 =====
APP_NAME=参赛项目 API
APP_ENV=local
DEBUG=true
SECRET_KEY=please-change-this-to-a-random-64-char-string

# ===== 数据库 =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=contest
POSTGRES_PASSWORD=contest
POSTGRES_DB=contest
# 使用托管数据库时可直接给完整连接串，优先级高于上面的分项配置
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 跨域（逗号分隔）=====
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 大模型 =====
# 任意 OpenAI 兼容网关都可以，这里以 OpenCode Zen 为例。
# 换别的厂商时只改这三行即可，业务代码不用动。
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
# 订阅制网关请用订阅端点：/zen/go/v1（按量计费是 /zen/v1）
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_TIMEOUT=60
# 部分网关要求额外请求头才能路由；"__auto__" 表示启动时生成一个 UUID
LLM_EXTRA_HEADERS={"x-opencode-session":"__auto__"}

# ===== 搜索 =====
# 联网检索用的独立服务（DeepSeek 搜索 API）；留空则跳过网页检索，
# 文献检索仍可走 OpenAlex / Crossref / Open Library。
SEARCH_PROVIDER=deepseek
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.deepseek.com/v1/tools
