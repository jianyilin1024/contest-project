# 统一行尾符，避免 Linux 服务器上的脚本因 CRLF 报错
* text=auto

# 服务器端脚本必须是 LF
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 端脚本保持 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
