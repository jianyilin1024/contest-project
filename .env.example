# ================= 本地 / 服务器通用 =================
# 复制为 .env 后按需修改。千万不要把真实 .env 提交到 Git。

# ---------- 端口 ----------
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- 数据库 ----------
POSTGRES_USER=contest
POSTGRES_PASSWORD=contest_dev_password
POSTGRES_DB=contest

# ---------- 前端访问后端的地址（浏览器可见，必须是公网可访问地址）----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- 后端应用 ----------
APP_ENV=local
DEBUG=true
SECRET_KEY=dev-only-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- 大模型 ----------
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash

# ---------- 搜索 ----------
SEARCH_PROVIDER=deepseek
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.deepseek.com/v1/tools

# ---------- 生产环境额外项 ----------
# 域名（生产 compose 与 Nginx 使用）
DOMAIN=example.com